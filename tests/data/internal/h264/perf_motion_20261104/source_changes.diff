+func TestMotionTrialStorage(t *testing.T) {
+	for radius := range 5 {
+		e, err := NewPredictive(34, 38, 24, PredictiveOptions{QP: 24, GOP: 7, InterResidual: true, MotionSearchRadius: radius})
+		if err != nil {
