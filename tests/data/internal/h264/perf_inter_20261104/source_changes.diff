+					t.Fatal("disabled path allocated workspace")
+				}
+				t.Logf("retained dynamic byte capacity=%d", encoderRetainedCapacity(e))
+				e.Reset()
+				if encoderRetainedCapacity(e) != 0 {
+					t.Fatal("Reset retained dynamic storage")
+				}
+			})
+		}
+	}
