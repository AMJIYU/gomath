+			glyphs := instanceShapes(root)
+			// Each clone owns glyph paths and paints in its own font/placement scope.
+			if glyphs[0].ID == glyphs[3].ID || glyphs[0] == glyphs[3] || glyphs[0].Style.FillGradient == glyphs[3].Style.FillGradient {
